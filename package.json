{
  "name": "orbs-of-magic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5",
    "express": "^4.22.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "colyseus.js": "^0.16.22",
    "concurrently": "^9.2.5",
    "three": "^0.180.0",
    "typescript": "5.9",
    "vite": "^6.4.5"
  }
}
